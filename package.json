{
    "name": "@darco2903/manager-api",
    "version": "1.3.0",
    "author": "Darco2903",
    "description": "",
    "keywords": [],
    "license": "MIT",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./client": {
            "types": "./dist/client.d.ts",
            "default": "./dist/client.js"
        },
        "./server": {
            "types": "./dist/server.d.ts",
            "default": "./dist/server.js"
        }
    },
    "files": [
        "dist"
    ],
    "engines": {
        "node": ">=22"
    },
    "packageManager": "pnpm@12.15.0",
    "homepage": "https://github.com/Darco2903/manager-api#readme",
    "bugs": {
        "url": "https://github.com/Darco2903/manager-api/issues"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/Darco2903/manager-api.git"
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "tsc",
        "check": "tsc --noEmit && tsc -p tests",
        "test": "vitest run",
        "prepack": "pnpm build",
        "clean": "rimraf -g dist darco2903-manager-api-*.tgz openapi.json",
        "generate:openapi": "tsx tools/generate-openapi.ts"
    },
    "dependencies": {
        "@darco2903/auth-api": "2.1.4",
        "@ts-rest/core": "^3.52.1",
        "@ts-rest/open-api": "^3.52.1",
        "jsonwebtoken": "^9.0.3",
        "socket.io-client": "^4.8.3",
        "zod": "^3.25.76"
    },
    "devDependencies": {
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^25.5.0",
        "prettier": "^3.8.1",
        "rimraf": "^6.1.3",
        "tsx": "^4.21.0",
        "typescript": "^5.9.3",
        "vitest": "^4.1.0"
    }
}
